<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(SolutionDir)Binaries\$(Configuration)\Tools\</OutputPath>
    <RootNamespace>DuelIt</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\File Type Libraries\StartingCollection\StartingCollection.csproj" />
    <!-- the card painter WolfX's Card Manager uses too -->
    <Compile Include="..\Shared\Editors\CardFacePainter.cs" Link="Shared\CardFacePainter.cs" />
  </ItemGroup>

</Project>
