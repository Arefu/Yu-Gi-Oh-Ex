<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(SolutionDir)Binaries\$(Configuration)\Tools\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\File Type Libraries\StartingCollection\StartingCollection.csproj" />
    <ProjectReference Include="..\..\File Type Libraries\PackDef\PackDef.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The card picker is shared with WolfX: search by name, tick many cards, paste a list of names. -->
    <Compile Include="..\WolfX\WolfX\File Type UI\CardCatalog.cs" Link="CardCatalog.cs" />
    <Compile Include="..\WolfX\WolfX\File Type UI\CardPickerDialog.cs" Link="CardPickerDialog.cs" />
    <Compile Include="..\WolfX\WolfX\File Type UI\CardPickerDialog.Designer.cs" Link="CardPickerDialog.Designer.cs" />
    <Compile Include="..\WolfX\WolfX\File Type UI\PasteNamesDialog.cs" Link="PasteNamesDialog.cs" />
    <Compile Include="..\WolfX\WolfX\File Type UI\PasteNamesDialog.Designer.cs" Link="PasteNamesDialog.Designer.cs" />
  </ItemGroup>

</Project>
