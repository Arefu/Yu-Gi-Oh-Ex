    <CodeEntry>
      <Description>Code :xchg [YuGiOh.exe+278EF14],bl</Description>
      <AddressString>YuGiOh.exe+7AB0D2</AddressString>
      <Before>
        <Byte>E8</Byte>
        <Byte>DE</Byte>
        <Byte>84</Byte>
        <Byte>0C</Byte>
        <Byte>00</Byte>
