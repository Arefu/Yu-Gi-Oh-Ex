  <UserdefinedSymbols />
  <LuaScript>-- LP is stored XORed with the u16 at Duel_DuelEngine+0 (YuGiOh-DUELSTATE.h). This custom type shows and writes it decoded.
local KEY = 0x143330280
local function key() return readSmallInteger(KEY) or 0 end
registerCustomTypeLua("LP (XOR key)", 4,
  function(b1, b2, b3, b4) return (byteTableToDword({b1, b2, b3, b4}) ~ key()) &amp; 0xFFFFFFFF end,
  function(value) local t = dwordToByteTable((value ~ key()) &amp; 0xFFFFFFFF); return t[1], t[2], t[3], t[4] end,
  false)
</LuaScript>
</CheatTable>
