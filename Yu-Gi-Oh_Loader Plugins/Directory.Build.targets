<Project>
  <!-- Every plugin keeps its manifest (<DLL>.json) next to its source, version-controlled. This copies it to the output
       Plugins folder on build so Binaries stays in step with source and the manifest is the one canonical copy. It only
       runs when a source manifest exists, so a plugin without one is left untouched. Auto-imported by every project under
       this folder - no per-project edits. (GUI plugins need their own copy of this file in their folder.) -->
  <Target Name="CopyPluginManifest" AfterTargets="Build" Condition="Exists('$(ProjectDir)$(TargetName).json')">
    <Copy SourceFiles="$(ProjectDir)$(TargetName).json" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Plugin manifest -&gt; $(OutDir)$(TargetName).json" />
  </Target>

  <!-- Files a plugin ships (pages, default data): <source>\Content\** is copied to <Plugins>\<DLL name>\ on build, so a plugin finds them
       next to itself (Yu-Gi-Oh-MP: pages\, banlists\). Only runs when the plugin has a Content folder. -->
  <Target Name="CopyPluginContent" AfterTargets="Build" Condition="Exists('$(ProjectDir)Content')">
    <ItemGroup>
      <PluginContent Include="$(ProjectDir)Content\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginContent)" DestinationFiles="@(PluginContent->'$(OutDir)$(TargetName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Plugin content -&gt; $(OutDir)$(TargetName)\" />
  </Target>
</Project>
