// Enter Password: eight digit wheels. Unlock finds the card with that password (bin\CARD_Pass.bin, or a custom card's "password"),
// charges value:password_price (card-store-prices.bob) and tops the card up to three copies. The card's details show once it is unlocked.
header "Enter Password";
use "card-store-prices";

user;

digits 8 at 280, 540 size 1360, 260 spacing 170 bind var:pw.code description "Up / down change a digit, left / right move.";

card "{var:pw.shown}" at 260, 120 width 486.5 if var:pw.shown;

menu pw at 760, 820 size 400, 200 {
    button "Unlock" "Unlock the card with this password."
        -> {
            set(var:pw.shown, "");
            set(var:card, "{game:password.{var:pw.code}}");
            if var:card = "0" -> { sound(71); message("This password is not for a card."); }
            else if game:owned.{var:card} >= 3 -> message("You already have 3 copies of {game:cardname.{var:card}}.")
            else if game:dp < value:password_price
                -> { sound(71); message("Unlocking a card costs {value:password_price} DP. You have {game:dp} DP."); }
            else take_dp(value:password_price) -> {
                give_card(var:card, 3);
                set(var:pw.shown, "{var:card}");
                sound(52);
                message("{game:cardname.{var:card}} is unlocked.");
            };
        };
    button "Back" -> { set(var:pw.shown, ""); back; };
}
