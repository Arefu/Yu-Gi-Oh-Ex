{
  "version": 2,
  "header": "Enter Password",
  "use": [
    "card-store-prices"
  ],
  "elements": [
    {
      "kind": "user"
    },
    {
      "kind": "digits",
      "count": 8,
      "x": 280,
      "y": 540,
      "width": 1360,
      "height": 260,
      "spacing": 170,
      "bind": "var:pw.code",
      "description": "Up / down change a digit, left / right move."
    },
    {
      "kind": "cardInfo",
      "card": "{var:pw.shown}",
      "x": 260,
      "y": 120,
      "width": 486.5,
      "visible": {
        "var": "pw.shown"
      }
    },
    {
      "kind": "menu",
      "id": "pw",
      "x": 760,
      "y": 820,
      "width": 400,
      "height": 200,
      "items": [
        {
          "label": "Unlock",
          "description": "Unlock the card with this password.",
          "action": [
            {
              "set": "var:pw.shown",
              "value": ""
            },
            {
              "set": "var:card",
              "value": "{game:password.{var:pw.code}}"
            },
            {
              "if": {
                "var": "card",
                "equals": "0"
              },
              "then": [
                {
                  "sound": 71
                },
                {
                  "message": "This password is not for a card."
                }
              ],
              "else": {
                "if": {
                  "game": "owned.{var:card}",
                  "atLeast": 3
                },
                "then": {
                  "message": "You already have 3 copies of {game:cardname.{var:card}}."
                },
                "else": {
                  "if": {
                    "game": "dp",
                    "atLeast": "{value:password_price}",
                    "not": true
                  },
                  "then": [
                    {
                      "sound": 71
                    },
                    {
                      "message": "Unlocking a card costs {value:password_price} DP. You have {game:dp} DP."
                    }
                  ],
                  "else": {
                    "takeDp": "{value:password_price}",
                    "then": [
                      {
                        "giveCard": "{var:card}",
                        "copies": 3
                      },
                      {
                        "set": "var:pw.shown",
                        "value": "{var:card}"
                      },
                      {
                        "sound": 52
                      },
                      {
                        "message": "{game:cardname.{var:card}} is unlocked."
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "label": "Back",
          "action": [
            {
              "set": "var:pw.shown",
              "value": ""
            },
            {
              "back": true
            }
          ]
        }
      ]
    }
  ]
}