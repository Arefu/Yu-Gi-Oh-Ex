// The Card Store, written in BOB (docs/PageScript.md). It replaced Yu-Gi-Oh-BetterCardShop's C++ store (StorePages.cpp, since deleted).
// The edit line below points the main menu's Card Shop button at this page (WolfX writes it to menus\bob-card-store.json).
header "Card Store";

edit cardShop -> page("card-store");

user;   // the player's name, avatar and DP, top right (as on the Battle Pack screen)

menu store at 160, 220 size 660, 500 {
    button "Buy Cards" "Buy the single cards you want, one copy at a time." -> page("card-store-shop");
    button "Password" "Enter a card's eight digit password." -> page("card-store-password");
    button "Buy Booster Packs" "Buy booster packs of random cards." -> goto(cardShop);
    // ready-made decks: the Booster Blast mod's page (pages\booster-blast-decks.bob)
    button "Buy Decks" "Buy a ready-made deck: it goes into your decks, with 3 of every card in it." -> page("booster-blast-decks");
    button "Back" -> back;
}
